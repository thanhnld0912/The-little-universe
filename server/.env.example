# The Little Universe - backend configuration
#
# Copy to `server/.env` and fill in. `.env` is gitignored and must never be
# committed. When pasting a connection string anywhere, mask the password.
#
# Every OPTIONAL variable below is passed through blankToUndefined() before
# validation, so leaving one blank is identical to omitting it. Setting a
# variable to an empty string will NOT silently become 0 or "".

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

NODE_ENV=development

# Neon PostgreSQL. Use the POOLED endpoint (the host containing "-pooler") and
# keep sslmode=require.
#   postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of allowed browser origins.
# "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# mock | openai | gemini
# `mock` requires no API key and is the default for development and tests.
#
# `mock` gives VARIETY, NOT UNIQUENESS: it picks from fixed lists, so two
# people will sometimes draw the same title. Only a real provider writes text
# that is genuinely different for each person. There is no fallback — if a
# provider is selected and cannot be built, the server fails loudly rather
# than quietly serving canned readings.
AI_PROVIDER=mock

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# PORT=4000
# JWT_EXPIRES_IN=7d

# IANA timezone that defines when the application's day rolls over.
# The product is aimed at readers in Vietnam, so "today" changes at midnight
# Asia/Ho_Chi_Minh (17:00 UTC the previous day), not at UTC midnight.
# Validated against the host timezone database at boot: a typo fails loudly.
# APP_TIMEZONE=Asia/Ho_Chi_Minh

# Required only when AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Required only when AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# How much the model varies between calls, 0-2.
# This is the knob that decides whether two people get different readings:
# every visitor on a given date sees the same prompt, because the astronomy is
# a shared fact, so variation is the only thing separating their text. Near 0
# a real provider regresses to the sameness the mock had, with a bill attached.
# AI_TEMPERATURE=0.9

# A per-request cap; the weekly forecast raises it to 3000 on its own, because
# it is seven readings in one document.
# AI_MAX_TOKENS=900
# AI_TIMEOUT_MS=20000

# Kept low on purpose: every warm serverless instance holds its own pool.
# DB_POOL_MAX=3

# Leave as true for Neon. Only set false for a self-signed local certificate.
# DB_SSL_REJECT_UNAUTHORIZED=true
